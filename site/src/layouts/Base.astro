---
import { url } from "../lib/data.js";

const { title, description = "Joe 每日要闻：AI 公司博客、技术博客与各大榜单，每天早上 8 点（纽约时间）更新。", active = "" } = Astro.props;
const nav = [
  ["today", "", "今日"],
  ["archive", "archive/", "归档"],
  ["sources", "sources/", "来源"],
  ["search", "search/", "搜索"],
];
const fullTitle = title ? `${title} · Joe 每日要闻` : "Joe 每日要闻";
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f7f5f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16171a" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={url("favicon.svg")} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Joe 每日要闻" href={url("rss.xml")} />
    <script is:inline>
      // Before first paint: theme, last chosen group (文章/榜单), and the .js hook for collapsing.
      const root = document.documentElement;
      root.classList.add("js");
      try {
        const t = localStorage.getItem("theme");
        if (t) root.dataset.theme = t;
        if (localStorage.getItem("tab") === "rank") root.dataset.tab = "rank";
      } catch {}
    </script>
  </head>
  <body>
    <header class="top">
      <div class="wrap top-row">
        <a class="brand" href={url()}>Joe 每日要闻</a>
        <nav>
          {nav.map(([key, href, label]) => (
            <a href={url(href)} aria-current={active === key ? "page" : undefined}>{label}</a>
          ))}
          <button class="theme" type="button" aria-label="切换浅色/深色" title="切换浅色/深色">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.39 5.39 0 0 1-4.4 2.26 5.4 5.4 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1Z"/></svg>
          </button>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="wrap foot">
      <a href={url("rss.xml")}>RSS 订阅</a>
      <span>·</span>
      <a href="https://github.com/awelynx/daily-news">GitHub</a>
      <span>·</span>
      <span>每天 8:00（纽约）生成，官方博客白天每 2 小时检查一次</span>
    </footer>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        document.querySelector(".theme").addEventListener("click", () => {
          const dark = root.dataset.theme ? root.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
          root.dataset.theme = dark ? "light" : "dark";
          try { localStorage.setItem("theme", root.dataset.theme); } catch {}
        });

        // 再看 N 条 / 持续在榜: expand in place. An open feed card also shows longer summaries.
        document.addEventListener("click", (e) => {
          const btn = e.target.closest(".more-btn");
          if (!btn) return;
          const open = btn.getAttribute("aria-expanded") !== "true";
          btn.setAttribute("aria-expanded", String(open));
          document.getElementById(btn.getAttribute("aria-controls")).classList.toggle("open", open);
          if (btn.dataset.label) btn.firstElementChild.textContent = open ? "收起" : btn.dataset.label;
          btn.closest(".card")?.classList.toggle("open", !!btn.closest(".card").querySelector(".more.open"));
        });

        // Links already opened show in the secondary text colour (kept per browser).
        let read = [];
        try { read = JSON.parse(localStorage.getItem("read") || "[]"); } catch {}
        const seen = new Set(read);
        const mark = () => document.querySelectorAll("a.t").forEach((a) => seen.has(a.href) && a.classList.add("read"));
        mark();
        document.addEventListener("click", (e) => {
          const a = e.target.closest("a.t");
          if (!a || seen.has(a.href)) return;
          seen.add(a.href);
          a.classList.add("read");
          try { localStorage.setItem("read", JSON.stringify([...seen].slice(-800))); } catch {}
        });
        window.markRead = mark;

        // Sticky offsets follow the real heights (the nav wraps at large text sizes).
        const sticky = [[".top", "--nav-real"], [".bar", "--bar-real"]];
        const ro = new ResizeObserver(() => sticky.forEach(([sel, v]) => {
          const el = document.querySelector(sel);
          if (el) root.style.setProperty(v, el.offsetHeight + "px");
        }));
        sticky.forEach(([sel]) => document.querySelector(sel) && ro.observe(document.querySelector(sel)));

        // The nav bar tucks away while scrolling down and comes back when scrolling up.
        let last = scrollY;
        addEventListener("scroll", () => {
          const y = scrollY;
          if (Math.abs(y - last) < 6) return;
          document.body.classList.toggle("nav-up", y > last && y > 160);
          last = y;
        }, { passive: true });
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f7f5f0;
    --panel: #ffffff;
    --text: #1d1d1f;
    --muted: #6b6a66;
    --faint: #e6e2d9;
    --accent: #c2410c;
    --accent-soft: #fbe9df;
    --link: #1d1d1f;
    --visited: #6b5d8f;
    --new: #15803d;
    --new-soft: #e3f4e8;
    --warn: #b45309;
    --warn-soft: #fdf0dc;
    --radius: 10px;
    --nav-h: 52px;
    --bar-h: 44px;
    --gutter: 16px;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #16171a;
      --panel: #1e1f23;
      --text: #e8e6e1;
      --muted: #9a988f;
      --faint: #2e2f34;
      --accent: #fb923c;
      --accent-soft: #3a2619;
      --link: #ece9e3;
      --visited: #b3a6d8;
      --new: #4ade80;
      --new-soft: #17301f;
      --warn: #fbbf24;
      --warn-soft: #362a12;
    }
  }
  :root[data-theme="dark"] {
    --bg: #16171a;
    --panel: #1e1f23;
    --text: #e8e6e1;
    --muted: #9a988f;
    --faint: #2e2f34;
    --accent: #fb923c;
    --accent-soft: #3a2619;
    --link: #ece9e3;
    --visited: #b3a6d8;
    --new: #4ade80;
    --new-soft: #17301f;
    --warn: #fbbf24;
    --warn-soft: #362a12;
  }
  * { box-sizing: border-box; }
  /* No scroll anchoring: showing the nav moves the sticky bar, and Chrome's anchoring would
     answer by nudging the page down, which hides the nav again. */
  html { -webkit-text-size-adjust: 100%; overflow-anchor: none; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 1rem/1.6 -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Noto Sans SC", "Microsoft YaHei", system-ui, sans-serif;
    overflow-wrap: anywhere;
  }
  a { color: var(--link); }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
  .wrap { max-width: 760px; margin: 0 auto; padding: 0 var(--gutter); }

  /* Nav: sticky, tucks away on scroll down. */
  .top {
    position: sticky; top: 0; z-index: 20;
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--faint);
    transition: transform .2s ease;
  }
  .nav-up .top { transform: translateY(-100%); }
  .top-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; min-height: var(--nav-h); flex-wrap: wrap; }
  .brand { font-weight: 700; text-decoration: none; letter-spacing: .02em; white-space: nowrap; }
  .brand::before { content: ""; display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); margin-right: 8px; vertical-align: 2px; }
  nav { display: flex; align-items: center; gap: 2px; }
  .top nav a { text-decoration: none; color: var(--muted); padding: 10px 8px; border-radius: 8px; font-size: .9375rem; white-space: nowrap; }
  .top nav a:hover { color: var(--text); background: var(--faint); }
  .top nav a[aria-current="page"] { color: var(--text); font-weight: 600; }
  .theme { border: 0; background: none; color: var(--muted); width: 40px; height: 40px; border-radius: 8px; cursor: pointer; display: grid; place-items: center; }
  .theme:hover { color: var(--text); background: var(--faint); }
  main { padding-top: 16px; padding-bottom: 24px; min-height: 70vh; }
  .foot { color: var(--muted); font-size: .8125rem; padding-top: 16px; padding-bottom: 40px; border-top: 1px solid var(--faint); display: flex; flex-wrap: wrap; gap: 6px; }
  .foot a { color: var(--muted); }

  h1 { font-size: 1.5rem; line-height: 1.3; margin: 4px 0 2px; letter-spacing: .01em; }
  h2 { font-size: 1.1875rem; margin: 28px 0 12px; display: flex; align-items: baseline; gap: 8px; }
  h2 .n { font-size: .8125rem; font-weight: 500; color: var(--muted); }
  h3 { font-size: .9375rem; margin: 0; }
  .sub { color: var(--muted); font-size: .875rem; margin: 0 0 10px; }
  .empty { color: var(--muted); }

  /* Status: only takes space when something is wrong. */
  .alert { background: var(--warn-soft); color: var(--warn); border-radius: 8px; padding: 0 12px; margin: 0 0 10px; font-size: .875rem; }
  .alert summary { cursor: pointer; padding: 10px 0; min-height: 44px; display: flex; align-items: center; list-style-position: inside; }
  .alert summary::before { content: "⚠"; margin-right: 6px; }
  .alert ul { margin: 0; padding: 0 0 10px 1.1em; }
  .alert b { color: var(--text); font-weight: 600; }
  .all-ok { color: var(--muted); font-size: .8125rem; margin: 20px 0 0; }

  /* 今日速览 */
  .overview { margin: 6px 0 12px; font-size: .875rem; color: var(--muted); }
  .overview p { margin: 0; padding: 3px 0; }
  .overview a { color: var(--muted); text-decoration: none; padding: 4px 0; }
  .overview a:hover { color: var(--accent); }
  .overview b { color: var(--text); font-weight: 600; font-variant-numeric: tabular-nums; }

  /* Sticky group switch + jump strip: one row under the nav. */
  .bar {
    position: sticky; top: var(--nav-real, var(--nav-h)); z-index: 10;
    display: flex; align-items: center; gap: 10px;
    min-height: var(--bar-h);
    margin: 0 calc(-1 * var(--gutter)) 8px; padding: 0 var(--gutter);
    background: var(--bg); /* opaque: text scrolling under the switch must not show through */
    border-bottom: 1px solid var(--faint);
    transition: top .2s ease;
  }
  .nav-up .bar { top: 0; }
  .tabs { flex: none; display: flex; background: var(--faint); border-radius: 9px; padding: 2px; }
  .tabs [role="tab"] {
    position: relative; border: 0; background: none; color: var(--muted); font: inherit; font-size: .875rem;
    padding: 4px 11px; border-radius: 7px; cursor: pointer; white-space: nowrap;
  }
  .tabs [role="tab"]::after { content: ""; position: absolute; inset: -8px 0; }
  .tabs [role="tab"] .n { font-size: .75rem; margin-left: 3px; font-variant-numeric: tabular-nums; }
  .tabs [role="tab"][aria-selected="true"] { background: var(--panel); color: var(--text); font-weight: 600; box-shadow: 0 1px 2px rgb(0 0 0 / .08); }
  .jumps { position: relative; flex: 1; min-width: 0; display: flex; gap: 2px; overflow-x: auto; scrollbar-width: none; mask-image: linear-gradient(90deg, #000 85%, transparent); }
  .jumps::-webkit-scrollbar { display: none; }
  .jumps a {
    flex: none; display: flex; align-items: center; min-height: var(--bar-h); padding: 0 7px;
    color: var(--muted); text-decoration: none; font-size: .8125rem; white-space: nowrap; border-bottom: 2px solid transparent;
  }
  .jumps a[aria-current="true"] { color: var(--text); border-bottom-color: var(--accent); }
  .js .bar .jumps:not([data-for="feeds"]) { display: none; }
  .js[data-tab="rank"] .bar .jumps[data-for="feeds"] { display: none; }
  .js[data-tab="rank"] .bar .jumps[data-for="rank"] { display: flex; }
  .to-top { flex: none; font-size: .8125rem; color: var(--accent); text-decoration: none; min-height: var(--bar-h); display: flex; align-items: center; }
  .to-top[hidden] { display: none; }
  .bar:not(:has(.jumps)) .tabs { margin-right: auto; }
  html:not(.js) .bar { display: none; }

  /* Panels: both shown without JS; with JS only the selected group. */
  .panel { scroll-margin-top: calc(var(--nav-real, var(--nav-h)) + var(--bar-real, var(--bar-h)) + 8px); }
  .nav-up .panel, .nav-up .card { scroll-margin-top: calc(var(--bar-real, var(--bar-h)) + 8px); }
  .js .panel-title { display: none; }
  .js [data-panel="rank"] { display: none; }
  .js[data-tab="rank"] [data-panel="rank"] { display: block; }
  .js[data-tab="rank"] [data-panel="feeds"] { display: none; }

  /* Cards */
  .card { background: var(--panel); border: 1px solid var(--faint); border-radius: var(--radius); padding: 4px 14px 2px; margin: 0 0 12px; scroll-margin-top: calc(var(--nav-real, var(--nav-h)) + var(--bar-real, var(--bar-h)) + 8px); }
  .card-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; padding: 10px 0 6px; margin: 0 -14px; padding-left: 14px; padding-right: 14px; border-radius: var(--radius) var(--radius) 0 0; transition: background .6s ease; }
  .card-head.flash { background: var(--accent-soft); transition: none; }
  .card-head a { color: inherit; text-decoration: none; }
  .card-head a:hover { color: var(--accent); }
  .card-head .meta { font-size: .75rem; color: var(--muted); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .caption { margin: -2px 0 6px; font-size: .75rem; color: var(--muted); }
  .items, .rows { list-style: none; margin: 0; padding: 0; }
  .item { padding: 8px 0; border-top: 1px solid var(--faint); }
  .card .items > .item:first-child { border-top: 0; }
  .t { text-decoration: none; font-weight: 500; }
  .t:hover { text-decoration: underline; text-underline-offset: 3px; }
  .t:visited, .t.read { color: var(--muted); }
  .note { color: var(--muted); font-size: .875rem; margin-top: 2px; line-height: 1.5; }
  .note a { color: var(--muted); }
  .clamp { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: var(--lines, 1); overflow: hidden; }
  .card.open .clamp { -webkit-line-clamp: 3; }

  /* Expand in place: grid rows 0fr -> 1fr. */
  .more { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .18s ease; }
  .more.open { grid-template-rows: 1fr; }
  .more-clip { overflow: hidden; min-height: 0; }
  html:not(.js) .more { grid-template-rows: 1fr; }
  html:not(.js) .more-btn { display: none; }
  .more:not(.open) .more-clip { visibility: hidden; transition: visibility 0s .18s; }
  .more-clip > .items > .item:first-child, .more-clip > .rows > .row:first-child { border-top: 1px solid var(--faint); }
  .more-btn {
    display: flex; justify-content: space-between; align-items: center; width: calc(100% + 28px); margin: 0 -14px; padding: 0 14px;
    min-height: 44px; border: 0; border-top: 1px solid var(--faint); background: none; color: var(--accent);
    font: inherit; font-size: .875rem; cursor: pointer; text-align: left;
  }
  .more-btn.quiet { color: var(--muted); }
  .more-btn:hover { color: var(--text); }
  .more-btn .chev { transition: transform .18s ease; }
  .more-btn[aria-expanded="true"] .chev { transform: rotate(180deg); }

  /* Ranking rows: rank | title block | right-aligned number. */
  .seg-label { display: flex; align-items: center; gap: 8px; font-size: .75rem; color: var(--muted); margin: 2px 0 0; }
  .seg-label::after { content: ""; flex: 1; border-top: 1px solid var(--faint); }
  .row { display: grid; grid-template-columns: 1.7em 1fr auto; column-gap: 6px; padding: 8px 0; border-top: 1px solid var(--faint); align-items: baseline; }
  .rows > .row:first-child { border-top: 0; }
  .rank { color: var(--muted); font-size: .8125rem; font-variant-numeric: tabular-nums; }
  .body { min-width: 0; }
  /* Title, then a small tag (language / task type) that wraps as a unit, no separator needed. */
  .title-line { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 6px; }
  .title-line .tt { min-width: 0; }
  .dot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--new); margin-right: 7px; vertical-align: .2em; }
  .tag { color: var(--muted); font-size: .8125rem; white-space: nowrap; }
  .org { color: var(--muted); font-weight: 400; font-size: .8125rem; }
  /* Repo/model names break after "org /" rather than at a hyphen inside the name. */
  .name { font-weight: 600; display: inline-block; max-width: 100%; overflow-wrap: anywhere; hyphens: none; }
  .row.dim .t { color: var(--muted); font-weight: 400; }
  .row.dim .name { font-weight: 500; }
  .meta-line { color: var(--muted); font-size: .8125rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .meta-line a { color: var(--muted); }
  .val { color: var(--muted); font-size: .8125rem; font-variant-numeric: tabular-nums; text-align: right; white-space: nowrap; }
  .val.days { display: flex; flex-direction: column; align-items: flex-end; gap: 3px; }
  .streak-bar { display: block; height: 2px; width: calc(var(--w) * 40px); background: var(--muted); border-radius: 1px; }

  .chip { flex: none; position: relative; border: 1px solid var(--faint); background: var(--panel); color: var(--muted); font: inherit; font-size: .8125rem; padding: 4px 11px; border-radius: 99px; cursor: pointer; text-decoration: none; }
  .chip::after { content: ""; position: absolute; inset: -7px 0; }
  .badge { display: inline-block; font-size: .72rem; line-height: 1; padding: 3px 6px; border-radius: 99px; margin-left: 6px; vertical-align: 2px; white-space: nowrap; font-weight: 500; }
  .badge.new { color: var(--new); background: var(--new-soft); }
  .badge.streak { color: var(--muted); background: var(--faint); }
  .badge.src { color: var(--accent); background: var(--accent-soft); margin-left: 0; margin-right: 6px; }
  .status { list-style: none; padding: 0; margin: 0; }
  .status li { background: var(--warn-soft); color: var(--warn); border-radius: 8px; padding: 8px 12px; margin-bottom: 8px; font-size: .875rem; }
  .pager { display: flex; justify-content: space-between; gap: 12px; margin-top: 24px; font-size: .875rem; }
  .pager a { color: var(--muted); text-decoration: none; padding: 10px 0; }
  .pager a:hover { color: var(--accent); }
  input[type="search"], select {
    font: inherit; border-radius: var(--radius); border: 1px solid var(--faint); background: var(--panel); color: var(--text); outline: none;
  }
  input[type="search"] { width: 100%; font-size: 1.0625rem; padding: 11px 14px; }
  input[type="search"]:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }

  @media (max-width: 480px) {
    .brand { font-size: .9375rem; }
    .top nav a { padding: 10px 6px; font-size: .875rem; }
    /* Full-bleed cards: drop side borders and corners for ~26px more line width. */
    .card { margin: 0 -16px 10px; border-left: 0; border-right: 0; border-radius: 0; padding: 2px 16px 0; }
    .card-head { margin: 0 -16px; padding-left: 16px; padding-right: 16px; border-radius: 0; }
    .more-btn { width: calc(100% + 32px); margin: 0 -16px; padding: 0 16px; }
  }
  /* ---- Wider screens. Phones (<768px) keep the single column above. ----
     Text columns stay 600–680px wide (about 36–42 Chinese characters); more width means more
     columns, never longer lines. */

  /* A group's cards sit in two lanes once the group is wide enough (container query); narrower,
     the lanes dissolve and each card's inline `order` restores source order. Lanes are separate
     columns, so expanding a card only moves the cards below it in the same lane. */
  .panel { container-type: inline-size; }
  .lanes { display: flex; flex-direction: column; }
  .lane { display: contents; }
  .col-strip { display: none; }
  @container (min-width: 720px) {
    .lanes { display: grid; grid-template-columns: 1fr 1fr; column-gap: 24px; align-items: start; }
    .lane { display: block; min-width: 0; }
  }

  @media (min-width: 768px) {
    :root { --gutter: 24px; }
    .wrap { max-width: 1140px; }
    .split-list { columns: 440px; column-gap: 32px; }
    .split-list > li { break-inside: avoid; }
    .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 440px), 1fr)); column-gap: 16px; align-items: start; }
  }

  /* Articles and rankings side by side; the 文章|榜单 switch and its bar give way to one sticky
     jump strip per column. */
  @media (min-width: 1200px) {
    .wrap { max-width: calc(2 * 680px + 24px + 2 * var(--gutter)); }
    .bar { display: none; }
    html.js .board > .panel[data-panel] { display: block; }
    .board { display: grid; grid-template-columns: 1fr 1fr; column-gap: 24px; align-items: start; }
    .overview { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 12px; margin: 12px 0 16px; }
    .overview .ov { background: var(--panel); border: 1px solid var(--faint); border-radius: var(--radius); padding: 10px 14px; }
    .col-strip.whole { display: flex; }
    .col-strip {
      position: sticky; top: var(--nav-real, var(--nav-h)); z-index: 5;
      background: var(--bg); border-bottom: 1px solid var(--faint); margin: 0 0 10px;
      transition: top .2s ease;
    }
    .nav-up .col-strip { top: 0; }
    .strip-label { flex: none; display: flex; align-items: center; font-weight: 600; font-size: .875rem; margin-right: 6px; }
    .strip-label .n { font-weight: 400; color: var(--muted); font-size: .75rem; margin-left: 3px; }
    .card, .panel { scroll-margin-top: calc(var(--nav-real, var(--nav-h)) + var(--bar-h) + 8px); }
