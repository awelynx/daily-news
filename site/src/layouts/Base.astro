---
import { url } from "../lib/data.js";
import favicon from "../../public/favicon.svg?raw";

// `intro`: the date of the digest on this page; its first visit plays the masthead entrance once.
const { title, description = "Joe 每日要闻：AI 公司博客、技术博客与各大榜单，每天早上 8 点（纽约时间）更新。", active = "", intro = "" } = Astro.props;
const nav = [
  ["today", "", "今日"],
  ["archive", "archive/", "归档"],
  ["sources", "sources/", "来源"],
  ["search", "search/", "搜索"],
];
const fullTitle = title ? `${title} · Joe 每日要闻` : "Joe 每日要闻";
const og = new URL(url("og.png"), Astro.site).href;
// The seal's glyph, reused inline for the header and footer marks.
const glyph = favicon.match(/<path d="([^"]+)"/)[1];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f6f3ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Joe 每日要闻" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={og} />
    <link rel="icon" href={url("favicon.ico")} sizes="48x48" />
    <link rel="icon" href={url("favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url("apple-touch-icon.png")} />
    <link rel="alternate" type="application/rss+xml" title="Joe 每日要闻" href={url("rss.xml")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Noto+Serif+SC:wght@400;600;700&display=swap" />
    <script is:inline define:vars={{ intro }}>
      // Before first paint: theme, last chosen group (文章/榜单), #all, the .js hook, and whether
      // this is the first visit to this day's page (only then does the masthead play its entrance).
      const root = document.documentElement;
      root.classList.add("js");
      if (location.hash === "#all") root.dataset.all = "open";
      try {
        const t = localStorage.getItem("theme");
        if (t) root.dataset.theme = t;
        if (localStorage.getItem("tab") === "rank") root.dataset.tab = "rank";
        if (intro && localStorage.getItem("intro") !== intro) {
          localStorage.setItem("intro", intro);
          if (localStorage.getItem("intro") === intro) root.classList.add("intro");
        }
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">跳到正文</a>
    <header class="top">
      <div class="wrap top-row">
        <a class="brand" href={url()} aria-label="Joe 每日要闻 首页">
          <svg class="seal" viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="5.33" /><path d={glyph} /></svg>
          <span class="brand-text">
            <span class="brand-name">每日要闻</span>
            <span class="brand-sub">JOE · DAILY WIRE</span>
          </span>
        </a>
        <nav aria-label="主导航">
          {nav.map(([key, href, label]) => (
            <a href={url(href)} aria-current={active === key ? "page" : undefined}>{label}</a>
          ))}
          <button class="theme" type="button" aria-label="切换浅色/深色" title="切换浅色/深色">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.39 5.39 0 0 1-4.4 2.26 5.4 5.4 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1Z"/></svg>
          </button>
        </nav>
      </div>
      <div class="progress" aria-hidden="true"></div>
    </header>
    <main class="wrap" id="main">
      <slot />
    </main>
    <footer class="foot">
      <div class="wrap foot-row">
        <svg class="seal" viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="5.33" /><path d={glyph} /></svg>
        <span>每天 8:00（纽约）生成</span>
        <span class="sep" aria-hidden="true">·</span>
        <a href={url("rss.xml")}>RSS</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href="https://github.com/awelynx/daily-news">GitHub</a>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        // Theme switch: all transitions off for the swap, so the whole page changes colour at once.
        document.querySelector(".theme").addEventListener("click", () => {
          const dark = root.dataset.theme ? root.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
          root.classList.add("theme-switching");
          root.dataset.theme = dark ? "light" : "dark";
          try { localStorage.setItem("theme", root.dataset.theme); } catch {}
          requestAnimationFrame(() => requestAnimationFrame(() => root.classList.remove("theme-switching")));
        });

        // 再看 N 条 / 持续在榜: expand in place. An open feed card also shows longer summaries.
        document.addEventListener("click", (e) => {
          const btn = e.target.closest(".more-btn");
          if (!btn) return;
          const open = btn.getAttribute("aria-expanded") !== "true";
          btn.setAttribute("aria-expanded", String(open));
          document.getElementById(btn.getAttribute("aria-controls")).classList.toggle("open", open);
          if (btn.dataset.label) btn.firstElementChild.textContent = open ? "收起" : btn.dataset.label;
          btn.closest(".card")?.classList.toggle("open", !!btn.closest(".card").querySelector(".more.open"));
        });

        // Links already opened show in the secondary text colour (kept per browser).
        let read = [];
        try { read = JSON.parse(localStorage.getItem("read") || "[]"); } catch {}
        const seen = new Set(read);
        const mark = () => document.querySelectorAll("a.t").forEach((a) => seen.has(a.href) && a.classList.add("read"));
        mark();
        document.addEventListener("click", (e) => {
          const a = e.target.closest("a.t");
          if (!a || seen.has(a.href)) return;
          seen.add(a.href);
          a.classList.add("read");
          try { localStorage.setItem("read", JSON.stringify([...seen].slice(-800))); } catch {}
        });
        window.markRead = mark;

        // Sticky offsets follow the real heights (the nav wraps at large text sizes).
        const sticky = [[".top", "--nav-real"], [".bar", "--bar-real"]];
        const ro = new ResizeObserver(() => sticky.forEach(([sel, v]) => {
          const el = document.querySelector(sel);
          if (el) root.style.setProperty(v, el.offsetHeight + "px");
        }));
        sticky.forEach(([sel]) => document.querySelector(sel) && ro.observe(document.querySelector(sel)));

        // The nav bar tucks away while scrolling down and comes back when scrolling up.
        let last = scrollY;
        addEventListener("scroll", () => {
          const y = scrollY;
          if (Math.abs(y - last) < 6) return;
          document.body.classList.toggle("nav-up", y > last && y > 160);
          last = y;
        }, { passive: true });
      })();
    </script>
  </body>
</html>

<style is:global>
  /* 晨报电讯: warm paper, ink, one vermilion. The old names (--bg, --text, --muted, --faint,
     --accent…) stay as aliases so the full-digest components read the new palette. */
  :root {
    --paper: #f6f3ec;
    --ink: #1a1a18;
    --ink-2: #55534d;
    --rule: #d9d4c7;
    --seal: #c8341f;
    --panel: #fbfaf6;
    --serif: "Noto Serif SC", "Songti SC", "STSong", serif;
    --sans: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Noto Sans SC", "Microsoft YaHei", system-ui, sans-serif;
    --mono: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, monospace;
    --ease: cubic-bezier(.2, .8, .2, 1);
    --nav-h: 52px;
    --bar-h: 44px;
    --gutter: 16px;
    --radius: 4px;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --paper: #121212;
      --ink: #ebe7de;
      --ink-2: #9c978c;
      --rule: #2c2a26;
      --seal: #e0563f;
      --panel: #191918;
    }
  }
  :root[data-theme="dark"] {
    --paper: #121212;
    --ink: #ebe7de;
    --ink-2: #9c978c;
    --rule: #2c2a26;
    --seal: #e0563f;
    --panel: #191918;
  }
  :root, :root[data-theme] {
    --seal-soft: color-mix(in srgb, var(--seal) 9%, var(--paper));
    --bg: var(--paper);
    --text: var(--ink);
    --muted: var(--ink-2);
    --faint: var(--rule);
    --accent: var(--seal);
    --accent-soft: var(--seal-soft);
    --link: var(--ink);
    --new: var(--seal);
    --warn: var(--seal);
    color-scheme: light;
  }
  :root[data-theme="dark"] { color-scheme: dark; }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) { color-scheme: dark; } }

  * { box-sizing: border-box; }
  /* No scroll anchoring: showing the nav moves the sticky bar, and Chrome's anchoring would
     answer by nudging the page down, which hides the nav again. */
  html { -webkit-text-size-adjust: 100%; overflow-anchor: none; scroll-padding-top: calc(var(--nav-real, var(--nav-h)) + 12px); }
  .theme-switching *, .theme-switching *::before, .theme-switching *::after { transition: none !important; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font: 1rem/1.6 var(--sans);
    overflow-wrap: anywhere;
    -webkit-font-smoothing: antialiased;
  }
  ::selection { background: color-mix(in srgb, var(--seal) 22%, transparent); color: var(--ink); }
  a { color: var(--link); text-underline-offset: .22em; text-decoration-thickness: 1px; }
  :focus-visible { outline: 2px solid var(--seal); outline-offset: 2px; border-radius: 2px; }
  input, select { accent-color: var(--seal); caret-color: var(--seal); }
  .wrap { max-width: 760px; margin: 0 auto; padding: 0 var(--gutter); }
  .skip { position: absolute; left: 8px; top: -60px; z-index: 30; background: var(--ink); color: var(--paper); padding: 8px 12px; font-size: .875rem; }
  .skip:focus { top: 8px; }

  /* Mono labels: the wire's small caps. */
  .label { font: 500 .6875rem/1.5 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-2); font-variant-numeric: tabular-nums; }

  /* Nav: sticky, opaque paper, tucks away on scroll down. */
  .top {
    position: sticky; top: 0; z-index: 20;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
    transition: transform .2s var(--ease);
  }
  .nav-up .top { transform: translateY(-100%); }
  .top-row { display: flex; align-items: center; justify-content: space-between; gap: 4px 8px; min-height: var(--nav-h); flex-wrap: wrap; }
  .seal { display: block; flex: none; }
  .seal rect { fill: var(--seal); }
  .seal path { fill: #fff; stroke: #fff; stroke-width: .77; stroke-linejoin: round; }
  .brand { display: flex; align-items: center; gap: 9px; text-decoration: none; color: var(--ink); white-space: nowrap; padding: 6px 0; }
  .brand .seal { width: 28px; height: 28px; }
  .brand-text { display: flex; flex-direction: column; }
  .brand-name { font: 700 1.0625rem/1.15 var(--serif); letter-spacing: .04em; }
  .brand-sub { display: none; font: 500 .5625rem/1.3 var(--mono); letter-spacing: .12em; color: var(--ink-2); margin-top: 2px; }
  nav { display: flex; align-items: center; gap: 0; }
  .top nav a { position: relative; text-decoration: none; color: var(--ink-2); padding: 10px 7px; font-size: .9375rem; white-space: nowrap; transition: color .15s var(--ease); }
  .top nav a:hover { color: var(--ink); }
  .top nav a[aria-current="page"] { color: var(--ink); font-weight: 600; }
  .top nav a[aria-current="page"]::after { content: ""; position: absolute; left: 7px; right: 7px; bottom: 4px; height: 2px; background: var(--seal); }
  .theme { border: 0; background: none; color: var(--ink-2); width: 40px; height: 40px; cursor: pointer; display: grid; place-items: center; border-radius: 2px; transition: color .15s var(--ease), transform .1s var(--ease); }
  .theme:hover { color: var(--ink); }
  .theme:active { transform: scale(.94); }
  /* Reading progress through the report (set by the page; hidden elsewhere). */
  .progress { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--seal); transform-origin: 0 50%; transform: scaleX(var(--read, 0)); opacity: var(--read-o, 0); transition: opacity .3s var(--ease); pointer-events: none; }
  @media (min-width: 768px) { .brand-sub { display: block; } }

  main { padding-top: 8px; padding-bottom: 40px; min-height: 70vh; }
  .foot { border-top: 1px solid var(--rule); }
  .foot-row { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; padding-top: 20px; padding-bottom: 44px; font: 400 .75rem/1.6 var(--mono); letter-spacing: .04em; color: var(--ink-2); }
  .foot .seal { width: 18px; height: 18px; margin-right: 2px; }
  .foot a { color: var(--ink-2); text-decoration-color: var(--rule); padding: 6px 0; }
  .foot a:hover { color: var(--ink); text-decoration-color: var(--seal); }

  h1 { font: 700 1.75rem/1.25 var(--serif); margin: 20px 0 6px; letter-spacing: .01em; text-wrap: balance; }
  h2 { font: 600 1.1875rem/1.4 var(--serif); margin: 32px 0 12px; display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 8px; }
  h2 .n { font: 400 .75rem var(--mono); color: var(--ink-2); letter-spacing: .04em; }
  h3 { font-size: .9375rem; margin: 0; }
  .sub { color: var(--ink-2); font: 400 .75rem/1.6 var(--mono); letter-spacing: .04em; margin: 0 0 14px; }
  .sub a { color: var(--ink-2); }
  .empty { color: var(--ink-2); }

  /* Status (full digest): only takes space when something is wrong. */
  .all-ok { color: var(--ink-2); font: .75rem var(--mono); letter-spacing: .04em; margin: 20px 0 0; }

  /* 今日速览 */
  .overview { margin: 6px 0 12px; font-size: .875rem; color: var(--ink-2); }
  .overview p { margin: 0; padding: 3px 0; }
  .overview a { color: var(--ink-2); text-decoration: none; padding: 4px 0; }
  .overview a:hover { color: var(--seal); }
  .overview b { color: var(--ink); font-weight: 600; font-family: var(--mono); font-variant-numeric: tabular-nums; }

  /* Sticky group switch + jump strip: one row under the nav. */
  .bar {
    position: sticky; top: var(--nav-real, var(--nav-h)); z-index: 10;
    display: flex; align-items: center; gap: 10px;
    min-height: var(--bar-h);
    margin: 0 calc(-1 * var(--gutter)) 8px; padding: 0 var(--gutter);
    background: var(--paper); /* opaque: text scrolling under the switch must not show through */
    border-bottom: 1px solid var(--rule);
    transition: top .2s var(--ease);
  }
  .nav-up .bar { top: 0; }
  .tabs { flex: none; display: flex; border: 1px solid var(--rule); border-radius: 3px; padding: 2px; }
  .tabs [role="tab"] {
    position: relative; border: 0; background: none; color: var(--ink-2); font: inherit; font-size: .875rem;
    padding: 4px 11px; border-radius: 2px; cursor: pointer; white-space: nowrap;
  }
  .tabs [role="tab"]::after { content: ""; position: absolute; inset: -8px 0; }
  .tabs [role="tab"] .n { font: .6875rem var(--mono); margin-left: 4px; font-variant-numeric: tabular-nums; }
  .tabs [role="tab"][aria-selected="true"] { background: var(--ink); color: var(--paper); font-weight: 600; }
  .jumps { position: relative; flex: 1; min-width: 0; display: flex; gap: 2px; overflow-x: auto; scrollbar-width: none; mask-image: linear-gradient(90deg, #000 85%, transparent); }
  .jumps::-webkit-scrollbar { display: none; }
  .jumps a {
    flex: none; display: flex; align-items: center; min-height: var(--bar-h); padding: 0 7px;
    color: var(--ink-2); text-decoration: none; font-size: .8125rem; white-space: nowrap; border-bottom: 2px solid transparent;
  }
  .jumps a[aria-current="true"] { color: var(--ink); border-bottom-color: var(--seal); }
  .js .bar .jumps:not([data-for="feeds"]) { display: none; }
  .js[data-tab="rank"] .bar .jumps[data-for="feeds"] { display: none; }
  .js[data-tab="rank"] .bar .jumps[data-for="rank"] { display: flex; }
  .to-top { flex: none; font: .75rem var(--mono); color: var(--seal); text-decoration: none; min-height: var(--bar-h); display: flex; align-items: center; }
  .to-top[hidden] { display: none; }
  .bar:not(:has(.jumps)) .tabs { margin-right: auto; }
  html:not(.js) .bar { display: none; }

  /* Panels: both shown without JS; with JS only the selected group. */
  .panel { scroll-margin-top: calc(var(--nav-real, var(--nav-h)) + var(--bar-real, var(--bar-h)) + 8px); }
  .nav-up .panel, .nav-up .card { scroll-margin-top: calc(var(--bar-real, var(--bar-h)) + 8px); }
  .js .panel-title { display: none; }
  .js [data-panel="rank"] { display: none; }
  .js[data-tab="rank"] [data-panel="rank"] { display: block; }
  .js[data-tab="rank"] [data-panel="feeds"] { display: none; }

  /* Cards: kept only in the full digest, where density matters. Flat paper, hairline edge. */
  .card { background: var(--panel); border: 1px solid var(--rule); border-radius: var(--radius); padding: 4px 14px 2px; margin: 0 0 12px; scroll-margin-top: calc(var(--nav-real, var(--nav-h)) + var(--bar-real, var(--bar-h)) + 8px); }
  .card-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; padding: 10px 0 6px; margin: 0 -14px; padding-left: 14px; padding-right: 14px; border-radius: var(--radius) var(--radius) 0 0; transition: background .6s var(--ease); }
  .card-head.flash { background: var(--seal-soft); transition: none; }
  .card-head h3 { font: 600 1rem/1.4 var(--serif); }
  .card-head a { color: inherit; text-decoration: none; }
  .card-head a:hover { color: var(--seal); }
  .card-head .meta { font: .6875rem var(--mono); letter-spacing: .04em; color: var(--ink-2); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .caption { margin: -2px 0 6px; font-size: .75rem; color: var(--ink-2); }
  .items, .rows { list-style: none; margin: 0; padding: 0; }
  ul.card.items { padding: 4px 14px 2px; margin-bottom: 12px; } /* a list that is itself the card */
  .item { padding: 8px 0; border-top: 1px solid var(--rule); }
  .card .items > .item:first-child { border-top: 0; }
  .t { text-decoration: none; font-weight: 500; }
  .t:hover { text-decoration: underline; text-decoration-color: var(--seal); }
  .t:visited, .t.read { color: var(--ink-2); }
  .note { color: var(--ink-2); font-size: .875rem; margin-top: 2px; line-height: 1.55; }
  .note a { color: var(--ink-2); }
  .clamp { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: var(--lines, 1); overflow: hidden; }
  .card.open .clamp { -webkit-line-clamp: 3; }

  /* Expand in place: grid rows 0fr -> 1fr. */
  .more { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .2s var(--ease); }
  .more.open { grid-template-rows: 1fr; }
  .more-clip { overflow: hidden; min-height: 0; }
  html:not(.js) .more { grid-template-rows: 1fr; }
  html:not(.js) .more-btn { display: none; }
  .more:not(.open) .more-clip { visibility: hidden; transition: visibility 0s .2s; }
  .more-clip > .items > .item:first-child, .more-clip > .rows > .row:first-child { border-top: 1px solid var(--rule); }
  .more-btn {
    display: flex; justify-content: space-between; align-items: center; width: calc(100% + 28px); margin: 0 -14px; padding: 0 14px;
    min-height: 44px; border: 0; border-top: 1px solid var(--rule); background: none; color: var(--seal);
    font: inherit; font-size: .875rem; cursor: pointer; text-align: left; transition: background .1s var(--ease);
  }
  .more-btn:active { background: color-mix(in srgb, var(--rule) 30%, transparent); }
  .more-btn.quiet { color: var(--ink-2); }
  .more-btn:hover { color: var(--ink); }
  .more-btn .chev { transition: transform .2s var(--ease); }
  .more-btn[aria-expanded="true"] .chev { transform: rotate(180deg); }

  /* Ranking rows: rank | title block | right-aligned number. */
  .seg-label { display: flex; align-items: center; gap: 8px; font: 500 .6875rem var(--mono); letter-spacing: .06em; color: var(--seal); margin: 2px 0 0; }
  .seg-label::after { content: ""; flex: 1; border-top: 1px solid var(--rule); }
  .row { display: grid; grid-template-columns: 1.7em 1fr auto; column-gap: 6px; padding: 8px 0; border-top: 1px solid var(--rule); align-items: baseline; }
  .rows > .row:first-child { border-top: 0; }
  .rank { color: var(--ink-2); font: .75rem var(--mono); font-variant-numeric: tabular-nums; }
  .body { min-width: 0; }
  /* Title, then a small tag (language / task type) that wraps as a unit, no separator needed. */
  .title-line { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 6px; }
  .title-line .tt { min-width: 0; }
  .dot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--seal); margin-right: 7px; vertical-align: .2em; }
  .tag { color: var(--ink-2); font-size: .8125rem; white-space: nowrap; }
  .org { color: var(--ink-2); font-weight: 400; font-size: .8125rem; }
  /* Repo/model names break after "org /" rather than at a hyphen inside the name. */
  .name { font-weight: 600; display: inline-block; max-width: 100%; overflow-wrap: anywhere; hyphens: none; }
  .row.dim .t { color: var(--ink-2); font-weight: 400; }
  .row.dim .name { font-weight: 500; }
  .meta-line { color: var(--ink-2); font-size: .8125rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .meta-line a { color: var(--ink-2); }
