---
import { url } from "../lib/data.js";

const { title, description = "Joe 每日要闻：AI 公司博客、技术博客与各大榜单，每天早上 8 点（纽约时间）更新。", active = "" } = Astro.props;
const nav = [
  ["today", "", "今日"],
  ["archive", "archive/", "归档"],
  ["sources", "sources/", "来源"],
  ["search", "search/", "搜索"],
];
const fullTitle = title ? `${title} · Joe 每日要闻` : "Joe 每日要闻";
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f7f5f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16171a" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={url("favicon.svg")} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Joe 每日要闻" href={url("rss.xml")} />
    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <header class="top">
      <div class="wrap top-row">
        <a class="brand" href={url()}>Joe 每日要闻</a>
        <nav>
          {nav.map(([key, href, label]) => (
            <a href={url(href)} aria-current={active === key ? "page" : undefined}>{label}</a>
          ))}
          <button class="theme" type="button" aria-label="切换浅色/深色" title="切换浅色/深色">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.39 5.39 0 0 1-4.4 2.26 5.4 5.4 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1Z"/></svg>
          </button>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="wrap foot">
      <a href={url("rss.xml")}>RSS 订阅</a>
      <span>·</span>
      <a href="https://github.com/awelynx/daily-news">GitHub</a>
      <span>·</span>
      <span>每天 8:00（纽约）生成，官方博客白天每 2 小时检查一次</span>
    </footer>
    <script is:inline>
      document.querySelector(".theme").addEventListener("click", () => {
        const root = document.documentElement;
        const dark = root.dataset.theme ? root.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        root.dataset.theme = dark ? "light" : "dark";
        try { localStorage.setItem("theme", root.dataset.theme); } catch {}
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f7f5f0;
    --panel: #ffffff;
    --text: #1d1d1f;
    --muted: #6b6a66;
    --faint: #e6e2d9;
    --accent: #c2410c;
    --accent-soft: #fbe9df;
    --link: #1d1d1f;
    --visited: #6b5d8f;
    --new: #15803d;
    --new-soft: #e3f4e8;
    --warn: #b45309;
    --warn-soft: #fdf0dc;
    --radius: 10px;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #16171a;
      --panel: #1e1f23;
      --text: #e8e6e1;
      --muted: #9a988f;
      --faint: #2e2f34;
      --accent: #fb923c;
      --accent-soft: #3a2619;
      --link: #ece9e3;
      --visited: #b3a6d8;
      --new: #4ade80;
      --new-soft: #17301f;
      --warn: #fbbf24;
      --warn-soft: #362a12;
    }
  }
  :root[data-theme="dark"] {
    --bg: #16171a;
    --panel: #1e1f23;
    --text: #e8e6e1;
    --muted: #9a988f;
    --faint: #2e2f34;
    --accent: #fb923c;
    --accent-soft: #3a2619;
    --link: #ece9e3;
    --visited: #b3a6d8;
    --new: #4ade80;
    --new-soft: #17301f;
    --warn: #fbbf24;
    --warn-soft: #362a12;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.65 -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Noto Sans SC", "Microsoft YaHei", system-ui, sans-serif;
    overflow-wrap: anywhere;
  }
  a { color: var(--link); }
  .wrap { max-width: 760px; margin: 0 auto; padding: 0 16px; }
  .top {
    position: sticky; top: 0; z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--faint);
  }
  .top-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; height: 52px; }
  .brand { font-weight: 700; text-decoration: none; letter-spacing: .02em; white-space: nowrap; }
  .brand::before { content: ""; display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); margin-right: 8px; vertical-align: 2px; }
  nav { display: flex; align-items: center; gap: 2px; }
  nav a { text-decoration: none; color: var(--muted); padding: 6px 9px; border-radius: 8px; font-size: 15px; white-space: nowrap; }
  nav a:hover { color: var(--text); background: var(--faint); }
  nav a[aria-current="page"] { color: var(--text); font-weight: 600; }
  .theme { border: 0; background: none; color: var(--muted); padding: 6px 8px; border-radius: 8px; cursor: pointer; display: grid; place-items: center; }
  .theme:hover { color: var(--text); background: var(--faint); }
  main { padding-top: 20px; padding-bottom: 32px; min-height: 70vh; }
  .foot { color: var(--muted); font-size: 13px; padding-top: 16px; padding-bottom: 40px; border-top: 1px solid var(--faint); display: flex; flex-wrap: wrap; gap: 6px; }
  .foot a { color: var(--muted); }
  h1 { font-size: 26px; line-height: 1.3; margin: 8px 0 4px; letter-spacing: .01em; }
  h2 { font-size: 19px; margin: 32px 0 12px; display: flex; align-items: baseline; gap: 8px; }
  h2 .n { font-size: 13px; font-weight: 500; color: var(--muted); }
  h3 { font-size: 15px; margin: 0; }
  .sub { color: var(--muted); font-size: 14px; margin: 0 0 8px; }
  .card { background: var(--panel); border: 1px solid var(--faint); border-radius: var(--radius); padding: 14px 16px; margin: 0 0 12px; }
  .card-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; margin-bottom: 6px; }
  .card-head a { color: inherit; text-decoration: none; }
  .card-head a:hover { color: var(--accent); }
  .card-head .meta { font-size: 12px; color: var(--muted); white-space: nowrap; }
  .items { list-style: none; margin: 0; padding: 0; }
  ol.items { counter-reset: r; }
  .item { padding: 8px 0; border-top: 1px solid var(--faint); }
  .item:first-child { border-top: 0; }
  ol.items .item { counter-increment: r; display: grid; grid-template-columns: 1.6em 1fr; column-gap: 4px; }
  ol.items .item::before { content: counter(r); color: var(--muted); font-size: 13px; font-variant-numeric: tabular-nums; padding-top: 2px; }
  .item .t { text-decoration: none; font-weight: 500; }
  .item .t:hover { text-decoration: underline; text-underline-offset: 3px; }
  .item .t:visited { color: var(--visited); }
  .item .note { color: var(--muted); font-size: 14px; margin-top: 2px; }
  .item .note a { color: var(--muted); }
  .badge { display: inline-block; font-size: 11.5px; line-height: 1; padding: 3px 6px; border-radius: 99px; margin-left: 6px; vertical-align: 2px; white-space: nowrap; font-weight: 500; }
  .badge.new { color: var(--new); background: var(--new-soft); }
  .badge.streak { color: var(--muted); background: var(--faint); }
  .badge.src { color: var(--accent); background: var(--accent-soft); margin-left: 0; margin-right: 6px; }
  .empty { color: var(--muted); }
  .chips { display: flex; gap: 6px; overflow-x: auto; padding: 4px 0 8px; margin: 0 -16px; padding-left: 16px; padding-right: 16px; scrollbar-width: none; }
  .chips::-webkit-scrollbar { display: none; }
  .chip { flex: none; border: 1px solid var(--faint); background: var(--panel); color: var(--muted); font: inherit; font-size: 13px; padding: 4px 11px; border-radius: 99px; cursor: pointer; text-decoration: none; }
  .chip:hover { color: var(--text); }
  .chip[aria-pressed="true"] { background: var(--text); color: var(--bg); border-color: var(--text); }
  .status { list-style: none; padding: 0; margin: 0; }
  .status li { background: var(--warn-soft); color: var(--warn); border-radius: 8px; padding: 8px 12px; margin-bottom: 8px; font-size: 14px; }
  .status li b { color: var(--text); font-weight: 600; }
  .ok { color: var(--new); font-size: 14px; }
  .pager { display: flex; justify-content: space-between; gap: 12px; margin-top: 28px; font-size: 14px; }
  .pager a { color: var(--muted); text-decoration: none; }
  .pager a:hover { color: var(--accent); }
  input[type="search"] {
    width: 100%; font: inherit; font-size: 17px; padding: 11px 14px; border-radius: var(--radius);
    border: 1px solid var(--faint); background: var(--panel); color: var(--text); outline: none;
  }
  input[type="search"]:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  @media (max-width: 480px) {
    body { font-size: 15.5px; }
    h1 { font-size: 22px; }
    .brand { font-size: 15px; }
    nav a { padding: 6px 6px; font-size: 14px; }
    .card { padding: 12px 13px; border-radius: 8px; }
  }
</style>
