---
import Item from "./Item.astro";
import { fmtTime, url } from "../lib/data.js";

const { sec } = Astro.props;
const List = sec.type === "ranking" ? "ol" : "ul";
---
<section class="card" data-source={sec.source}>
  <div class="card-head">
    <h3><a href={url(`sources/${sec.source}/`)}>{sec.name}</a></h3>
    <span class="meta">{sec.stale ? `${fmtTime(sec.fetched)} 的快照` : `${sec.items.length} 条`}</span>
  </div>
  <List class="items">{sec.items.map((item) => <Item item={item} />)}</List>
</section>
