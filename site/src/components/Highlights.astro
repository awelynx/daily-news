---
import { fmtTime, short } from "../lib/data.js";
import { renderMarkdown } from "../lib/md.js";

// 今日汇报 + its items (news/data/highlights/DATE.json). The report is Joe's written summary;
// below it each item links to the main article, with a pill for every place the story appeared.
// A rules-only pick has no summary and shows just the items, under 今日重点.
const { hl } = Astro.props;
const BY = { joe: "Joe", "claude-api": "Claude", rules: "规则" };
const hasSummary = !!hl.summary?.trim();
const num = (n) => n.toLocaleString("en-US");
const metric = (s) =>
  s.score == null ? "" : s.score_kind === "stars" ? ` +${num(s.score)}★` : s.score_kind === "likes" ? ` ❤${num(s.score)}` : ` ${num(s.score)}分`;
// Several links from one source (three Anthropic posts, four repos) are told apart by name.
const pill = (s, item) => {
  const same = item.sources.filter((x) => x.source === s.source).length > 1;
  const name = s.title?.includes("/") ? s.title.split("/").pop() : s.title ?? "";
  const label = same && name ? (name.length > 22 ? name.slice(0, 21) + "…" : name) : short(s.source) + (s.rank ? ` 第${s.rank}` : "");
  return label + metric(s);
};
---
<section class:list={["hl", { "with-summary": hasSummary }]} aria-labelledby="hl-title">
  {hasSummary && (
    <div class="report">
      <div class="hl-head">
        <h2 id="hl-title">今日汇报</h2>
        <span class="meta">由 {BY[hl.by] ?? hl.by} 生成 · {fmtTime(hl.generated)}</span>
      </div>
      <div class="report-body" set:html={renderMarkdown(hl.summary)} />
    </div>
  )}
  <div class="picks">
  <div class="hl-head">
    {hasSummary ? <h3>提到的条目</h3> : <h2 id="hl-title">今日重点</h2>}
    <span class="meta">{hl.items.length} 条{!hasSummary && ` · 按${BY[hl.by] ?? hl.by}挑选`}</span>
  </div>
  <ol class="hl-list">
    {hl.items.map((item) => (
      <li class="hl-item">
        <a class="t hl-title" href={item.url} target="_blank" rel="noopener">
          <span class="hl-tag">{item.tag}</span>{item.title_zh}
        </a>
        {item.title && item.title !== item.title_zh && <div class="hl-orig">{item.title}</div>}
        <p class="hl-why">{item.why}</p>
        <div class="hl-src">
          {item.sources.map((s) => (
            <a class="pill" href={s.url} target="_blank" rel="noopener" title={`${s.name}：${s.title ?? ""}`}>{pill(s, item)}</a>
          ))}
        </div>
      </li>
    ))}
  </ol>
  </div>
</section>

<style>
  .hl { margin: 6px 0 14px; display: grid; gap: 14px; }
  .report { background: var(--panel); border: 1px solid var(--faint); border-radius: var(--radius); padding: 12px 16px 4px; }
  .report-body { font-size: 1rem; line-height: 1.75; }
  .report-body :global(p) { margin: 0 0 10px; }
  .report-body :global(ul) { margin: 0 0 10px; padding-left: 1.2em; }
  .report-body :global(a) { color: var(--accent); text-underline-offset: 3px; }
  .report-body :global(code) { font-size: .875em; background: var(--faint); padding: 0 4px; border-radius: 4px; }
  .hl-head h3 { margin: 0; font-size: .9375rem; color: var(--muted); }
  /* With a report above, the items become a compact list: one line of reason each. */
  .with-summary .hl-list { gap: 8px; }
  .with-summary .hl-item { padding: 9px 12px; }
  .with-summary .hl-title { font-size: .9375rem; }
  .with-summary .hl-orig { display: none; }
  .with-summary .hl-why { margin: 2px 0 6px; font-size: .8125rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  /* Pills stay on one line and scroll sideways rather than adding rows. */
  .with-summary .hl-src { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; padding: 7px 0; margin: -6px 0; }
  .with-summary .pill::after { inset: -6px -2px; } /* inside the row's padding, so nothing overflows */
  .with-summary .hl-src::-webkit-scrollbar { display: none; }
  @media (max-width: 480px) {
    .report { padding: 10px 14px 2px; }
    .report-body { font-size: .9375rem; line-height: 1.7; }
    .with-summary .hl-list { gap: 6px; }
    .with-summary .hl-item { padding: 8px 12px; }
  }
  /* Wide screens: report and items side by side, so the whole report fits one screen. */
  @media (min-width: 1200px) {
    .hl.with-summary { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); align-items: start; }
    .with-summary .hl-list { grid-template-columns: 1fr; }
  }
  .hl-head { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; margin-bottom: 8px; }
  .report .hl-head { margin-bottom: 4px; }
  .hl-head h2 { margin: 0; font-size: 1.1875rem; }
  .hl-head .meta { font-size: .75rem; color: var(--muted); }
  .hl-list {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
  }
  .hl-item { background: var(--panel); border: 1px solid var(--faint); border-radius: var(--radius); padding: 12px 14px; min-width: 0; }
  .hl-title { display: block; font-size: 1.0625rem; font-weight: 600; line-height: 1.45; }
  .hl-tag {
    display: inline-block; font-size: .6875rem; font-weight: 500; line-height: 1; padding: 3px 6px; margin-right: 7px;
    border-radius: 4px; color: var(--accent); background: var(--accent-soft); vertical-align: .18em;
  }
  .hl-orig { color: var(--muted); font-size: .8125rem; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .hl-why { margin: 6px 0 8px; font-size: .9375rem; line-height: 1.55; }
  .hl-src { display: flex; flex-wrap: wrap; gap: 6px; }
  .pill {
    position: relative; flex: none; font-size: .75rem; color: var(--muted); text-decoration: none; white-space: nowrap;
    border: 1px solid var(--faint); border-radius: 99px; padding: 2px 9px; font-variant-numeric: tabular-nums;
  }
  .pill::after { content: ""; position: absolute; inset: -8px -2px; } /* 44px touch target */
  .pill:hover { color: var(--accent); border-color: var(--accent); }
</style>
