---
import Base from "../layouts/Base.astro";
import { sources, url } from "../lib/data.js";
---
<Base title="搜索" active="search">
  <h1>搜索</h1>
  <form role="search" class="search" onsubmit="return false">
    <input id="q" type="search" placeholder="标题、摘要或来源名" aria-label="搜索关键词" autocomplete="off" enterkeyhint="search" autofocus />
    <select id="source" aria-label="来源">
      <option value="">全部来源</option>
      {sources.map((s) => <option value={s.id}>{s.short ?? s.name}</option>)}
    </select>
  </form>
  <p id="info" class="sub" aria-live="polite">载入中……</p>
  <div id="results"></div>
</Base>

<script is:inline define:vars={{ dataUrl: url("search.json"), base: url() }}>
  const q = document.getElementById("q");
  const sel = document.getElementById("source");
  const info = document.getElementById("info");
  const out = document.getElementById("results");
  const params = new URL(location.href).searchParams;
  q.value = params.get("q") || "";
  sel.value = params.get("source") || "";
  let data, timer, composing = false;
  const esc = (s) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);
  const re = (t) => new RegExp(t.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"), "gi");
  // Highlight on the raw text, escaping the pieces in between.
  const mark = (s, terms) => {
    if (!terms.length) return esc(s);
    const rx = new RegExp(terms.map((t) => re(t).source).join("|"), "gi");
    let html = "", at = 0;
    for (const m of s.matchAll(rx)) {
      html += esc(s.slice(at, m.index)) + "<mark>" + esc(m[0]) + "</mark>";
      at = m.index + m[0].length;
    }
    return html + esc(s.slice(at));
  };
  function render() {
    const u = new URL(location.href);
    q.value ? u.searchParams.set("q", q.value) : u.searchParams.delete("q");
    sel.value ? u.searchParams.set("source", sel.value) : u.searchParams.delete("source");
    history.replaceState(null, "", u);
    if (!data) return;
    const terms = q.value.toLowerCase().split(/\s+/).filter(Boolean);
    const source = sel.value;
    if (!terms.length && !source) {
      info.textContent = `共 ${data.items.length} 条可搜。`;
      out.innerHTML = "";
      return;
    }
    const hits = data.items
      .filter((i) => (!source || i.s === source) && terms.every((t) => (i.t + " " + i.n + " " + data.sources[i.s]).toLowerCase().includes(t)))
      .sort((a, b) => (a.d < b.d ? 1 : a.d > b.d ? -1 : 0));
    const shown = hits.slice(0, 200);
    info.textContent = hits.length
      ? `找到 ${hits.length} 条${hits.length > shown.length ? `，显示最近 ${shown.length} 条` : ""}。`
      : "没有找到。试试来源名或英文关键词。";
    const days = Object.groupBy(shown, (i) => i.d);
    out.innerHTML = Object.entries(days).map(([d, items]) => `
      <section class="card">
        <div class="card-head"><h3><a href="${base}d/${d}/">${d}</a></h3><span class="meta">${items.length} 条</span></div>
        <ul class="items split-list">${items.map((i) => `<li class="item">
          <a class="t" href="${esc(i.u)}" target="_blank" rel="noopener">${mark(i.t, terms)}</a>
          <div class="note"><span class="src">${esc(data.sources[i.s] || i.s)}</span>${i.n ? " · " + mark(i.n, terms) : ""}</div>
        </li>`).join("")}</ul>
      </section>`).join("");
    window.markRead?.();
  }
  const later = () => { clearTimeout(timer); timer = setTimeout(render, 120); };
  q.addEventListener("compositionstart", () => (composing = true));
  q.addEventListener("compositionend", () => { composing = false; later(); });
  q.addEventListener("input", () => composing || later());
  sel.addEventListener("change", render);
  fetch(dataUrl).then((r) => r.json()).then((d) => { data = d; render(); }, () => (info.textContent = "搜索数据载入失败，请刷新重试。"));
  render();
</script>

<style>
  .search { display: flex; gap: 8px; margin: 12px 0 8px; max-width: 680px; }
  .search select { flex: none; max-width: 38%; padding: 0 10px; font-size: .9375rem; min-height: 44px; }
  #results :global(mark) { background: var(--accent-soft); color: inherit; border-radius: 3px; padding: 0 1px; }
  #results :global(.src) { color: var(--accent); }
  #results :global(.note) { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
</style>
