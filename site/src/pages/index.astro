---
import Base from "../layouts/Base.astro";
import Digest from "../components/Digest.astro";
import { digests, fmtTime, freshHits, latest, url } from "../lib/data.js";

const prev = digests[1];
---
<Base active="today" intro={latest?.date}>
  {latest ? (
    <Digest d={latest} heading="今日要闻">
      {freshHits.length > 0 && (
        <aside class="wire" aria-labelledby="wire-title">
          <h2 class="label wire-head" id="wire-title"><span class="pulse" aria-hidden="true"></span>Wire<span class="wire-sub"> · 刚刚发布</span></h2>
          <ul>
            {freshHits.map((h) => (
              <li data-time={h.time}>
                <time datetime={h.time}>{fmtTime(h.time)}</time>
                <span class="who">{h.name.replace(/ News$| Blog$/, "")}</span>
                <a class="t" href={h.url} target="_blank" rel="noopener">{h.title}</a>
              </li>
            ))}
          </ul>
        </aside>
      )}
    </Digest>
  ) : <p class="empty">还没有日报。</p>}
  <nav class="pager" aria-label="翻页">
    <span />
    {prev && <a href={url(`d/${prev.date}/`)}>前一天 {prev.date} →</a>}
  </nav>
</Base>

<script is:inline>
  // A vermilion dot on wire items that arrived since the last visit to the front page.
  (() => {
    let last = 0;
    try { last = Date.parse(localStorage.getItem("lastVisit") || "") || 0; localStorage.setItem("lastVisit", new Date().toISOString()); } catch {}
    if (last) document.querySelectorAll(".wire li[data-time]").forEach((li) => Date.parse(li.dataset.time) > last && li.classList.add("unseen"));
  })();
</script>

<style>
  .wire { margin: 0; border-bottom: 1px solid var(--rule); padding: 14px 0 6px; }
  .wire-head { display: flex; align-items: center; gap: 8px; margin: 0 0 4px; color: var(--seal); }
  .wire-sub { color: var(--ink-2); margin-left: -4px; }
  .pulse { width: 7px; height: 7px; border-radius: 50%; background: var(--seal); animation: pulse 2s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: .3; } }
  .wire ul { list-style: none; margin: 0; padding: 0; }
  .wire li { position: relative; display: flex; flex-wrap: wrap; column-gap: 8px; align-items: baseline; padding: 7px 0; font-size: .9375rem; line-height: 1.5; }
  .wire li + li { border-top: 1px dashed var(--rule); }
  .wire time { flex: none; width: 2.75rem; font: 500 .75rem var(--mono); color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .wire .who { flex: none; width: 5.5rem; font: 500 .6875rem var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .wire a { flex: 1 1 10em; min-width: 0; font-weight: 500; }
  .wire li.unseen::before { content: ""; position: absolute; left: -12px; top: 15px; width: 6px; height: 6px; border-radius: 50%; background: var(--seal); }
  @media (max-width: 480px) { .wire li.unseen::before { left: -10px; } }
  @media (prefers-reduced-motion: reduce) { .pulse { animation: none; } }
</style>
