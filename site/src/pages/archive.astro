---
import Base from "../layouts/Base.astro";
import { count, digests, hasHistory, highlights, newCount, url, weekday } from "../lib/data.js";

const months = Object.entries(Object.groupBy(digests, (d) => d.date.slice(0, 7)));
// Each day leads with its 今日重点; days without one preview the highest-scoring ranking item
// (HN), else the first new post.
const preview = (d) =>
  d.rankings.flatMap((s) => s.items).filter((i) => i.score != null).sort((a, b) => b.score - a.score)[0] ?? d.feeds[0]?.items[0];
---
<Base title="归档" active="archive">
  <h1>归档</h1>
  <p class="sub">共 {digests.length} 期日报</p>
  {months.map(([month, ds]) => (
    <>
      <h2>{month.replace("-", " 年 ")} 月</h2>
      <ul class="card items split-list">
        {ds.map((d) => (
          <li class="item day">
            <a class="t" href={url(`d/${d.date}/`)}>
              <span class="date">{d.date.slice(5).replace("-", " 月 ")} 日 <span class="wd">{weekday(d.date)}</span></span>
              <span class="stats">
                文章 {count(d.feeds)} · {d.rankings.some(hasHistory) ? `新上榜 ${newCount(d.rankings)}` : `榜单 ${count(d.rankings)}`}
                {d.status.length > 0 && <span class="warn"> · {d.status.length} 个来源异常</span>}
              </span>
            </a>
            {highlights[d.date] ? (
              <ol class="picks">
                {highlights[d.date].items.map((h) => (
                  <li><span class="tag">{h.tag}</span><a href={h.url} target="_blank" rel="noopener">{h.title_zh}</a></li>
                ))}
              </ol>
            ) : preview(d) && <div class="note clamp">{preview(d).title}</div>}
          </li>
        ))}
      </ul>
    </>
  ))}
</Base>

<style>
  .day .t { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; padding: 4px 0; }
  .wd { color: var(--muted); font-weight: 400; font-size: .875rem; margin-left: 4px; }
  .stats { color: var(--muted); font-size: .8125rem; font-weight: 400; font-variant-numeric: tabular-nums; }
  .warn { color: var(--warn); }
  .picks { list-style: none; margin: 4px 0 2px; padding: 0; font-size: .875rem; }
  .picks li { padding: 3px 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .picks a { color: var(--text); text-decoration: none; }
  .picks a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .tag { display: inline-block; font-size: .6875rem; line-height: 1; padding: 3px 5px; margin-right: 6px; border-radius: 4px; color: var(--accent); background: var(--accent-soft); vertical-align: .12em; }
</style>
